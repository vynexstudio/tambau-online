datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Usuários e Níveis de Acesso
enum Role {
  ADMINISTRADOR
  EDITOR
  AUTOR
  COLUNISTA
  PARCEIRO
  EMPRESA
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(AUTOR)
  avatarUrl String?
  bio       String?
  posts     Post[]
  createdAt DateTime @default(now())
}

// 2. Categorias
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  posts     Post[]
}

// 3. Notícias (Posts)
enum PostStatus {
  RASCUNHO
  REVISAO
  AGENDADA
  PUBLICADA
}

model Post {
  id             String      @id @default(uuid())
  title          String
  subtitle       String?
  slug           String      @unique
  content        String
  featuredImage  String
  imageCaption   String?
  gallery        String[]    // URLs de imagens
  videoUrl       String?
  source         String?
  isPlantao      Boolean     @default(false)
  isFeatured     Boolean     @default(false)
  viewsCount     Int         @default(0)
  status         PostStatus  @default(RASCUNHO)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  tags           String[]
  
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  
  authorId       String
  author         User        @relation(fields: [authorId], references: [id])
  
  comments       Comment[]
  views          PostView[]
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// 4. Obituário
model Obituary {
  id             String    @id @default(uuid())
  fullName       String
  photoUrl       String?
  birthDate      DateTime?
  deathDate      DateTime
  age            Int?
  wakeLocation   String?
  wakeTime       String?
  burialLocation String?
  burialTime     String?
  message        String?
  createdAt      DateTime  @default(now())
}

// 5. Classificados
enum ClassifiedCategory {
  IMOVEIS
  VEICULOS
  EMPREGOS
  COMPRA_E_VENDA
  SERVICOS
  ANIMAIS
  DIVERSOS
}

enum ClassifiedStatus {
  PENDENTE
  PUBLICADO
  DESTAQUE
  EXPIRADO
}

model Classified {
  id          String             @id @default(uuid())
  title       String
  description String
  price       Float?
  images      String[]
  category    ClassifiedCategory
  status      ClassifiedStatus   @default(PENDENTE)
  contactName String
  whatsapp    String
  phone       String?
  location    String?
  createdAt   DateTime           @default(now())
}

// 6. Guia Comercial
enum BusinessTier {
  GRATUITO
  DESTAQUE
  PATROCINADOR
}

model Business {
  id          String       @id @default(uuid())
  name        String
  logoUrl     String?
  category    String
  description String
  phone       String?
  whatsapp    String
  instagram   String?
  facebook    String?
  website     String?
  address     String
  workingHours String?
  photos      String[]
  tier        BusinessTier @default(GRATUITO)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

// 7. Eventos (Agenda Tambaú)
model Event {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String?
  description String
  eventDate   DateTime
  eventTime   String
  location    String
  organizer   String?
  whatsapp    String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// 8. Empregos
model Job {
  id           String   @id @default(uuid())
  company      String
  title        String
  description  String
  requirements String?
  salary       String?
  benefits     String?
  location     String   @default("Tambaú - SP")
  contact      String
  deadline     DateTime?
  createdAt    DateTime @default(now())
}

// 9. Publicidade & Anunciantes
enum AdPosition {
  BANNER_TOPO
  BANNER_LATERAL
  BANNER_ENTRE_NOTICIAS
  BANNER_DENTRO_DA_MATERIA
  BANNER_RODAPE
  EMPRESA_DESTAQUE
  NOTICIA_PATROCINADA
}

enum AdStatus {
  ATIVO
  PAUSADO
  AGENDADO
  EXPIRADO
}

model Advertiser {
  id          String         @id @default(uuid())
  company     String
  contactName String
  email       String
  phone       String
  ads         Advertisement[]
  createdAt   DateTime       @default(now())
}

model Advertisement {
  id           String      @id @default(uuid())
  title        String
  imageUrl     String
  linkUrl      String
  position     AdPosition
  targetCategory String?   // Exibe apenas em determinada categoria (null = todo o site)
  startDate    DateTime
  endDate      DateTime
  status       AdStatus    @default(ATIVO)
  viewsCount   Int         @default(0)
  clicksCount  Int         @default(0)
  
  advertiserId String
  advertiser   Advertiser  @relation(fields: [advertiserId], references: [id])
  
  createdAt    DateTime    @default(now())
}

// 10. Envios dos Leitores ("Envie uma Notícia")
enum SubmissionStatus {
  NOVO
  EM_ANALISE
  APROVADO
  PUBLICADO
  ARQUIVADO
}

model Submission {
  id          String           @id @default(uuid())
  senderName  String
  whatsapp    String
  email       String?
  title       String
  description String
  mediaUrls   String[]
  location    String?
  status      SubmissionStatus @default(NOVO)
  createdAt   DateTime         @default(now())
}

// 11. Comentários, Newsletter e Métrica de Visualizações
model Comment {
  id        String   @id @default(uuid())
  author    String
  content   String
  approved  Boolean  @default(false)
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

model PostView {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  viewedAt  DateTime @default(now())
}
